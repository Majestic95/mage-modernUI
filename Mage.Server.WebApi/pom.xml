<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Standalone Maven project. NOT registered in the parent pom.xml on purpose:
        keeping this fork's modifications scoped to new directories preserves
        upstream rebase compatibility. Build with:
            mvn -f Mage.Server.WebApi/pom.xml package
        Test with:
            mvn -f Mage.Server.WebApi/pom.xml test
    -->

    <groupId>org.mage</groupId>
    <artifactId>mage-server-webapi</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mage Server WebApi</name>
    <description>JSON/WebSocket facade in front of the embedded Mage server.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <upstream.version>1.4.58</upstream.version>
    </properties>

    <dependencies>
        <!-- Embeds the upstream server in-process. mage-server transitively
             pulls in mage, mage-common, the player AI plugins, JBoss Remoting,
             ORMLite, H2, etc. -->
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-server</artifactId>
            <version>${upstream.version}</version>
        </dependency>

        <!-- AI-8 (2026-05-05): the MAD AI plugin is a runtime-scope dep of
             mage-server (same shape as mage-deck-constructed). For our
             CommanderComputerPlayer7 subclass to compile against
             ComputerPlayerControllableProxy, we need it at compile time.
             Promoting to compile scope here doesn't change runtime
             behavior (mage-server already loads it). Without this, the
             AI-8 subclass can't extend the upstream class. -->
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-player-ai-ma</artifactId>
            <version>${upstream.version}</version>
        </dependency>

        <!-- Same precedent as the MAD AI promotion above:
             mage-deck-constructed is runtime-scope on mage-server, but the
             WebApiPauperValidator subclass needs Pauper.class on the compile
             classpath. Promoting here doesn't change runtime behavior
             (mage-server already loads it via DeckValidatorFactory wiring
             in config.xml); without this, the subclass cannot compile. -->
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-deck-constructed</artifactId>
            <version>${upstream.version}</version>
        </dependency>

        <!-- Lightweight HTTP/WS framework (per ADR 0002). -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.7.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
        <!-- SLF4J binding is provided transitively by mage-server (reload4j). -->

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            CARDS-1 (2026-05-13): pull the upstream Mage.Tests harness onto
            our test compile classpath via build-helper add-test-source
            (see <build> below). That harness uses JUnit 4 (@org.junit.Test +
            org.junit.Assert), so we need:
              * junit-vintage-engine: bridge that lets Surefire 5+ run
                JUnit 4 tests. Transitively pulls junit:junit:4.13.x.
              * mage-game-twoplayerduel, mage-player-ai, mage-game-freeforall:
                runtime-scope under mage-server; we need them at TEST scope
                here so CardTestPlayerBase / TestComputerPlayer compile.
              * jsoup, jaxb-api, jaxb-impl, truevfs: a handful of files in
                Mage.Tests/src/test/java (CardHintsTest, ZipFilesReadWriteTest,
                LoadCallbackClient) reference these; the added source tree
                must compile in full so these deps are required even though
                no GoShintai assertion needs them.
            All test-scope; runtime WebApi jar is unaffected.
        -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-game-twoplayerduel</artifactId>
            <version>${upstream.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-player-ai</artifactId>
            <version>${upstream.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mage</groupId>
            <artifactId>mage-game-freeforall</artifactId>
            <version>${upstream.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.21.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>2.3.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.java.truevfs</groupId>
            <artifactId>truevfs-profile-base</artifactId>
            <version>0.14.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                CARDS-1 (2026-05-13): bring the upstream Mage.Tests harness
                (CardTestPlayerBase + CardTestPlayerAPIImpl + TestPlayer +
                the rest of the @Test tree) onto OUR test compile path
                WITHOUT modifying upstream Mage.Tests/pom.xml. That pom
                deliberately skips install/jar (so a normal test-jar
                dependency cannot be published), and CLAUDE.md rule 2
                forbids edits there. Adding the source tree directly is
                the only path that keeps upstream untouched.

                We do NOT want to RUN upstream tests from inside our
                module — only compile the harness so OUR tests can extend
                CardTestPlayerBase. Surefire (below) is configured to
                exclude org/mage/** from execution.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-mage-tests-harness-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../Mage.Tests/src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-mage-tests-harness-resources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../Mage.Tests/src/test/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                        JBoss Remoting 2.5.4 (transitively pulled in by mage-server)
                        uses pre-module-system reflection that JDK 9+ rejects.
                        These flags let the existing protocol work on JDK 17+ during
                        test runs. Phase 1 spike confirmed these are sufficient for
                        both server and client launches; narrowing the set is a
                        Phase 2 concern.
                    -->
                    <argLine>
                        --add-opens java.base/java.io=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/sun.nio.ch=ALL-UNNAMED
                        --add-opens java.base/java.net=ALL-UNNAMED
                        --add-opens java.base/sun.security.action=ALL-UNNAMED
                    </argLine>
                    <!--
                        Surefire default run scope:
                          * Exclude org/mage/** so upstream tests added via
                            build-helper don't execute here (compile only).
                          * Exclude mage/webapi/cards/** so card-engine tests
                            run in the dedicated execution below with the
                            cwd=Mage.Tests override the harness requires
                            (config/config.xml + saved/ resolved relative
                            to cwd; see MageTestPlayerBase.init()).
                    -->
                    <excludes>
                        <exclude>org/mage/**</exclude>
                        <exclude>mage/webapi/cards/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>cards-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <!--
                                Cards tests extend CardTestPlayerBase, which
                                needs cwd = Mage.Tests so the upstream harness
                                can resolve config/config.xml + "RB Aggro.dck" +
                                saved/ relative to that directory (see
                                MageTestPlayerBase.init()).
                            -->
                            <workingDirectory>${project.basedir}/../Mage.Tests</workingDirectory>
                            <includes>
                                <include>mage/webapi/cards/**/*.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
