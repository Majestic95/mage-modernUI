syntax: glob

# global files
**/db
**/saved
**/target
#un-ignore target implementations
!Mage/src/main/java/mage/target

# logs and logs rotation
*.log
*.log.*
*/gamelogs
*/gamelogsJson
*/gamesHistory

# Mage.Client
Mage.Client/plugins/images
Mage.Client/plugins/plugin.data
# TODO: must save serverlist.txt to temporary files, not root folder
Mage.Client/serverlist.txt

# Mage.Server
Mage.Server/config/init.txt
Mage.Server/extensions

# Mage.Verify
# downloadable files
Mage.Verify/*.zip
Mage.Verify/*.json

# Utils
# TODO: remove outdated files and scripts
releases
Utils/author.txt

# TODO: remove with outdated perl scripts
Utils/*_tracker.txt
Utils/*implemented.txt

# dev environments, IDE and OS
# IntelliJ IDEA
.idea
*.iml
# Visual Studio Code
.vscode
.history
# Eclipse
.metadata
.project
.settings
.factorypath
**/bin
**/out
# NetBeans
**/nb-configuration.xml
# Atom
.build-tools.cson
# mac os
.DS_Store

# build tools
mage-bundle.zip
.env

# local secrets — tunnel tokens, API keys, anything credential-shaped.
# Never committed; read at runtime by ops scripts.
.secrets/

# build targets
/deploy
/temp

# playtest runtime state — scripts/playtest-up.sh writes ngrok PID,
# tunnel URL, vercel deploy log here. Per-session ephemeral.
/.playtest/

# T2.A — Scryfall oracle_cards bulk-data cache. Populated at WebApi
# boot by PauperLegalityService (~30-40 MB JSON, refreshed daily).
# Never committed; regenerated on demand at runtime.
mage-stack/cache/

# vercel project link (per-deployer, not committed) — webclient
# directory only; root vercel deploys aren't expected
/webclient/.vercel/

# node_modules at any depth — vitest can write a .vite cache
# at the repo root if invoked from the wrong cwd. The webclient
# subfolder has its own gitignore covering its node_modules; this
# root rule catches stragglers.
node_modules/
.vercel
