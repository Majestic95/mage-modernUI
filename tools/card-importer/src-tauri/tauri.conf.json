{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMage Card Importer Workbench",
  "version": "0.1.0",
  "identifier": "com.xmage.card-importer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XMage Card Importer Workbench",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri://localhost https://api.scryfall.com; img-src 'self' data: https://*.scryfall.io https://api.scryfall.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
