# cloudflared ingress configuration.
#
# Generated from this template at install time by install-service.ps1.
# Placeholders are substituted with values from config.json + the
# tunnel-create output:
#
#   <TUNNEL_UUID>         — UUID printed by `cloudflared tunnel create`
#   <CREDENTIALS_FILE>    — path to the tunnel JSON credentials file
#   <HOSTNAME>            — public hostname (e.g., modern-mage.com)
#   <LOCAL_SERVICE>       — http://localhost:<webapi.port>
#
# Do not edit this file directly — edit the template, or re-run
# install-service.ps1 to regenerate.

tunnel: <TUNNEL_UUID>
credentials-file: <CREDENTIALS_FILE>

# Run as a single-instance connector. We don't need ha-replicas for a
# personal-scale deployment.
no-autoupdate: true

# Ingress rules are evaluated top-to-bottom. The catch-all 404 at the
# end is required by cloudflared — without it, unmatched requests would
# fall through to a default 502 from the connector itself, which is
# more confusing than a clean 404.
ingress:
  # API route at api.<HOSTNAME>. The web app lives at the <HOSTNAME>
  # apex via a Vercel custom domain (DNS-only/gray-cloud at Cloudflare),
  # so cloudflared does not serve the apex - only api. is routed here.
  # Cloudflare proxy MUST be enabled (orange cloud) on the api CNAME
  # for tunnel routing to work; "DNS only" returns a private IPv6 ULA
  # and TCP fails. See reference_cloudflare_tunnel_gotchas memory.
  - hostname: api.<HOSTNAME>
    service: <LOCAL_SERVICE>
    originRequest:
      # Javalin serves both REST and WebSocket on the same port.
      # Cloudflare auto-detects WS via the Upgrade header; these flags
      # preserve connection-keep-alive longer for in-game streams.
      connectTimeout: 10s
      keepAliveTimeout: 90s
      noTLSVerify: false
  - service: http_status:404
